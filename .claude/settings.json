{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan about:*)",
      "Bash(php artisan config:clear)",
      "Bash(php artisan view:clear)",
      "Bash(php artisan migrate:status)",
      "Bash(php artisan migrate --pretend)",
      "Bash(php -l:*)",
      "Bash(php -v)",
      "Bash(composer test:*)",
      "Bash(composer show:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(npm run build)",
      "Bash(bash .claude/hooks/tasks.sh:*)",
      "Bash(bash .claude/hooks/stack.sh)",
      "Bash(bash .claude/hooks/verify-browser.sh:*)",
      "Bash(bash .claude/hooks/git-sync.sh:*)",
      "Bash(printenv LARAVEL_WF_DEV_URL)",
      "Bash(git status)",
      "mcp__laravel-boost__search-docs",
      "mcp__laravel-boost__database-schema",
      "mcp__laravel-boost__database-query",
      "mcp__laravel-boost__application-info",
      "mcp__laravel-boost__last-error",
      "mcp__laravel-boost__read-log-entries",
      "mcp__laravel-boost__browser-logs",
      "mcp__laravel-boost__get-absolute-url",
      "mcp__laravel-boost__database-connections",
      "Bash(bash .claude/hooks/repo-map.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env.*)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.testing)",
      "Read(./auth.json)",
      "Read(./storage/**)",
      "Read(./**/*.pem)",
      "Read(./**/oauth-*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.composer/auth.json)",
      "Read(~/.config/composer/auth.json)",
      "Bash(bash .claude/hooks/verify.sh --baseline:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-owner.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-comments.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(laravel-.*|blade-.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-context.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
